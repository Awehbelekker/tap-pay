# Copy to .env for local development: cp .env.example .env
# Every value below is DEV ONLY. The app refuses to start in production with any of these
# placeholder secrets. Generate real ones with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"   # ENCRYPTION_KEY
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"      # TAG_MASTER_KEY
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))" # JWT_SECRET, HASH_PEPPER

NODE_ENV=development
TZ=Africa/Johannesburg
# Working name; see docs/OPEN_QUESTIONS.md Q5 before using it in Meta templates.
PRODUCT_NAME=KakEnBetaal
PORT=3000
LOG_LEVEL=info

DATABASE_URL=postgres://tappay:tappay@localhost:5432/tappay
# Disposable database for integration tests. It is wiped by the test run: never point it at real data.
TEST_DATABASE_URL=postgres://tappay:tappay@localhost:5432/tappay_test
PUBLIC_API_URL=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_TAP_DOMAIN=localhost:3000

JWT_SECRET=dev-only-jwt-secret-change-me-0000000000
ENCRYPTION_KEY=dGFwLXBheSBkZXYgb25seSBrZXksIG5ldmVyIHByb2Q=
HASH_PEPPER=dev-only-hash-pepper-change-me-000000000
TAG_MASTER_KEY=00000000000000000000000000000000

CLAIM_TOKEN_TTL_SECONDS=120
SESSION_TTL_MINUTES=10
BILL_EXPIRY_HOURS=24

# WhatsApp: sim uses packages/wa-sim; cloud needs the four Cloud API values.
WA_MODE=sim
WA_PHONE_NUMBER=27600000000
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=
WA_GRAPH_VERSION=v23.0
WA_TEMPLATE_LANG=en
WA_APP_SECRET=dev-only-wa-app-secret
WA_VERIFY_TOKEN=dev-only-wa-verify-token
WA_SIM_PORT=4000
WA_SIM_URL=http://localhost:4000

# Payments: mock | peach | payfast. Split strategy: ledger_only | native | collect_then_payout.
PROVIDER=mock
SPLIT_STRATEGY=ledger_only
# collect_then_payout means holding third-party funds: refused in production unless true (OPEN_QUESTIONS L1).
FUNDS_FLOW_LEGAL_SIGNOFF=false
# Static (NTAG213) tags have no replay protection: refused in production unless true (SPEC 18).
ALLOW_STATIC_TAGS=false
MOCK_PROVIDER_SECRET=dev-only-mock-provider-secret

# Test environments (PayFast sandbox, Peach testsecure). Set false for real money.
PROVIDER_SANDBOX=true
PEACH_ENTITY_ID=
PEACH_CLIENT_ID=
PEACH_CLIENT_SECRET=
PEACH_MERCHANT_ID=
PEACH_SECRET_TOKEN=
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# Web Push (M4). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

SENTRY_DSN=

# Exposed to the web app at build time (Vite). Never put secrets in VITE_ variables.
VITE_PRODUCT_NAME=KakEnBetaal
VITE_PUBLIC_API_URL=http://localhost:3000
