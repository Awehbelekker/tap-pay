{
  "name": "tap-pay",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @tappay/api --filter @tappay/worker --filter @tappay/web --filter @tappay/wa-sim dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run --no-file-parallelism",
    "test:watch": "vitest",
    "e2e": "echo 'Playwright e2e lands in M1' && exit 0",
    "db:migrate": "pnpm --filter @tappay/db migrate up",
    "db:rollback": "pnpm --filter @tappay/db migrate down",
    "db:seed": "pnpm --filter @tappay/db seed",
    "gen:api": "openapi-typescript api/openapi.yaml -o packages/core/src/generated/api.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.0",
    "openapi-typescript": "^7.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.0",
    "fast-check": "^4.3.0"
  }
}
